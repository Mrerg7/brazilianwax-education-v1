---
import Icon from './Icon.astro';
import { SITE } from '../config/site';

const asking = Number(SITE.askingPrice).toLocaleString('en-US');
---

<section id="acquire" class="bg-[#2D2D2D] text-white scroll-mt-24">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20 text-center">
    <div class="max-w-xl mx-auto">
      <div
        class="inline-block px-4 py-1 bg-white/10 rounded-full text-xs font-medium tracking-wider mb-6"
      >
        ASKING ${asking} · ESCROW WELCOME
      </div>

      <h2
        class="text-3xl sm:text-4xl md:text-[3rem] font-semibold tracking-tighter leading-tight sm:leading-none mb-6"
      >
        Own the definitive name for<br class="hidden sm:block" />Brazilian waxing education.
      </h2>

      <p class="text-base sm:text-xl text-white/70 mb-8 sm:mb-10">
        brazilianwax.education is the perfect domain for a professional training academy that
        combines expert epilation instruction with practical business startup skills. Capture the
        growing demand in one of the beauty industry's most profitable niches.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a
          href="/acquire/#inquire"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-x-3 min-h-12 px-8 sm:px-10 py-3.5 sm:py-4 bg-white text-[#2D2D2D] hover:bg-[#F8F1E9] font-semibold text-base sm:text-lg rounded-3xl transition-all active:scale-[0.985]"
        >
          <span>Make an Offer</span>
          <Icon name="fa-envelope" class="w-5 h-5" />
        </a>

        <a
          href="/acquire/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-x-3 min-h-12 px-8 py-3.5 sm:py-4 border border-white/30 hover:bg-white/5 font-medium text-base sm:text-lg rounded-3xl transition-all"
        >
          Transfer &amp; escrow details
        </a>
      </div>

      <p class="mt-8 text-sm text-white/50">
        Serious inquiries only. Response within one business day.
      </p>
    </div>
  </div>
</section>
