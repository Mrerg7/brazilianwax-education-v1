---
import Icon from './Icon.astro';
---

<div
  class="md:hidden fixed inset-x-0 bottom-0 z-50 border-t border-[#EDE4D7] bg-white/95 backdrop-blur-md pb-[env(safe-area-inset-bottom)]"
>
  <div class="flex items-center gap-3 px-4 py-3">
    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-bold tracking-[0.14em] text-[#B85C38]">DOMAIN FOR SALE · $9,500</p>
      <p class="truncate text-sm font-semibold text-[#2D2D2D]">brazilianwax.education</p>
    </div>
    <a
      href="/acquire/#inquire"
      class="inline-flex shrink-0 items-center justify-center gap-2 min-h-11 px-4 rounded-2xl bg-[#B85C38] text-white text-sm font-semibold"
    >
      Make an offer
      <Icon name="fa-arrow-right" class="w-4 h-4" />
    </a>
  </div>
</div>
