---
import '../styles/global.css';
import StickyOffer from '../components/StickyOffer.astro';
import { OG_IMAGE, SITE } from '../config/site';
import { buildSchema, type Crumb } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  path?: string;
  crumbs?: Crumb[];
  includeFaq?: boolean;
  article?: boolean;
  preloadImage?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
  noindex = false,
  path = Astro.url.pathname,
  crumbs,
  includeFaq = false,
  article = false,
  preloadImage,
} = Astro.props;

const normalizedPath = path.endsWith('/') || path === '/' ? path : `${path}/`;
const canonicalURL = noindex ? new URL('/', SITE.url) : new URL(normalizedPath, SITE.url);
const structuredData = buildSchema({
  title,
  description,
  path: noindex ? '/' : normalizedPath,
  crumbs,
  includeFaq,
  article,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F8F1E9" />
    <meta name="author" content="Desert Rich" />
    <meta name="format-detection" content="telephone=no" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="brazilianwax.education — premium Brazilian waxing training domain for sale"
    />
    <meta property="og:locale" content={SITE.locale} />
    {article && <meta property="article:modified_time" content={SITE.modified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="brazilianwax.education — premium Brazilian waxing training domain for sale"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {
      SITE.googleSiteVerification && (
        <meta name="google-site-verification" content={SITE.googleSiteVerification} />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://imagedelivery.net" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap"
    />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="pb-20 md:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[80] focus:bg-white focus:px-4 focus:py-2 focus:rounded-xl"
    >
      Skip to content
    </a>
    <slot />
    {!noindex && <StickyOffer />}
  </body>
</html>
