---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — brazilianwax.education"
  description="The page you requested could not be found."
  noindex={true}
  path="/404/"
>
  <main id="main" class="min-h-screen flex items-center justify-center bg-[#F8F1E9] px-4">
    <div class="text-center px-6">
      <div class="text-8xl font-display text-[#B85C38] mb-4">404</div>
      <h1 class="text-2xl font-semibold text-[#2D2D2D] mb-4">Page Not Found</h1>
      <p class="text-[#5C5C5C] mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist. Return home or go straight to the acquisition
        form for brazilianwax.education.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center min-h-12 px-8 py-3 bg-[#B85C38] hover:bg-[#A04E30] text-white font-semibold rounded-2xl transition-all"
        >
          Back to Homepage
        </a>
        <a
          href="/acquire/"
          class="inline-flex items-center justify-center min-h-12 px-8 py-3 border border-[#EDE4D7] bg-white hover:bg-[#F8F1E9] text-[#2D2D2D] font-semibold rounded-2xl transition-all"
        >
          Acquire Domain
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
